{
  "name": "branch-diff",
  "version": "3.1.4",
  "description": "A tool to list print the commits on one git branch that are not on another using loose comparison",
  "main": "branch-diff.js",
  "type": "module",
  "bin": {
    "branch-diff": "./branch-diff.js"
  },
  "scripts": {
    "lint": "standard",
    "format": "standard --fix",
    "build": "true",
    "test:ci": "npm run test",
    "test": "npm run lint"
  },
  "author": "Rod <rod@vagg.org> (http://r.va.gg/)",
  "license": "MIT",
  "dependencies": {
    "changelog-maker": "^4.0.0",
    "commit-stream": "^2.0.1",
    "gitexec": "^2.0.1",
    "minimist": "^1.2.8",
    "pkg-to-id": "^0.0.3",
    "split2": "^4.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Renegade334/branch-diff.git"
  },
  "preferGlobal": true,
  "devDependencies": {
    "standard": "^17.0.0"
  }
}
